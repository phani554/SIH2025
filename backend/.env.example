# Copy to .env and fill in. Never commit .env.

# LLM provider: "openai" (needs OPENAI_API_KEY) or "offline" (no network, rule-based demo mode).
# With LLM_PROVIDER=openai but no key, the app falls back to offline.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBED_MODEL=text-embedding-3-small

DB_PATH=metromind.db
UPLOAD_DIR=uploads
CHUNK_SIZE_WORDS=200
CHUNK_OVERLAP_WORDS=40
CHUNK_STRATEGY=recursive         # fixed | recursive | sentence
USE_HYDE=true                    # default for /ask; the request can override
REVIEW_CONFIDENCE_THRESHOLD=0.6

# Security
AUTH_ENABLED=true                # every request needs an X-API-Key (python -m scripts.seed_demo prints two)
REDACT_PII=true                  # mask Aadhaar / PAN / phone / email before text reaches the LLM or the index
RATE_LIMIT_PER_MINUTE=120
MAX_UPLOAD_MB=15
FRONTEND_ORIGIN=http://localhost:5173
