# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini" (needs GEMINI_API_KEY) or "offline" (no network, rule-based demo mode)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

DB_PATH=metromind.db
UPLOAD_DIR=uploads
CHUNK_SIZE_WORDS=200
CHUNK_OVERLAP_WORDS=40
CHUNK_STRATEGY=recursive        # fixed | recursive | sentence
USE_HYDE=true                    # default for /ask; the request can override
REVIEW_CONFIDENCE_THRESHOLD=0.6

# Security
AUTH_ENABLED=true                # every request needs an X-API-Key (create one: python -m scripts.create_api_key)
REDACT_PII=true                  # mask Aadhaar / PAN / phone / email before text reaches the LLM or the index
RATE_LIMIT_PER_MINUTE=30
MAX_UPLOAD_MB=15
FRONTEND_ORIGIN=http://localhost:5173

# Gmail ingestion (optional)
GCLIENT_ID=
GCLIENT_SECRET=
GREDIRECT_URI=http://localhost:8000/gmail/callback
GMAIL_QUERY=has:attachment is:unread
GMAIL_LABEL=KMRL_Processed
