# Copy to .env and fill in. Never commit .env.

# LLM provider: "gemini" (needs GEMINI_API_KEY) or "offline" (no network, rule-based demo mode)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001

DB_PATH=metromind.db
UPLOAD_DIR=uploads
CHUNK_SIZE_WORDS=200
CHUNK_OVERLAP_WORDS=40
REVIEW_CONFIDENCE_THRESHOLD=0.6
FRONTEND_ORIGIN=http://localhost:5173

# Gmail ingestion (optional)
GCLIENT_ID=
GCLIENT_SECRET=
GREDIRECT_URI=http://localhost:8000/gmail/callback
GMAIL_QUERY=has:attachment is:unread
GMAIL_LABEL=KMRL_Processed
